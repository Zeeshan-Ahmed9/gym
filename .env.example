# ==============================================================================
# Gym Management System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your local credentials.
# Do NOT commit real credentials or secret keys to version control.

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gym_management?schema=public"

# Auth.js (NextAuth v5) Configuration
# Generate a secret with: openssl rand -base64 32 or npx auth secret
AUTH_SECRET="your-super-secret-auth-key-change-this-in-production"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"
